# Environment variables for end-to-end tests (pytest -m e2e)
# Copy this file to .env and fill in your values.

# GCP project ID to create the temporary BigQuery dataset in
DUMPTY_E2E_GCP_PROJECT=my-gcp-project

# GCS bucket name (no gs:// prefix) to stage extracted data
DUMPTY_E2E_GCS_BUCKET=my-test-bucket

# Path to a service account JSON key file (optional — omit to use Application Default Credentials)
# DUMPTY_E2E_CREDENTIALS=/path/to/credentials.json
